# Ключ Claude API для разговорного учёта (раздел «Учёт денег · ИИ»)
# Получить: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# модель можно переопределить (по умолчанию claude-sonnet-4-5)
# KOSMOS_AI_MODEL=claude-sonnet-4-5

# Supabase public client config для будущей web/CRM-части.
# Это public/anon значения отдельного проекта Космос Сервиса, не Разберёмся.
KOSMOS_SUPABASE_URL=https://YOUR_KOSMOS_PROJECT_REF.supabase.co
KOSMOS_SUPABASE_ANON_KEY=YOUR_KOSMOS_PUBLIC_ANON_KEY

# Supabase CLI/deploy helpers. Реальные значения хранить только локально.
KOSMOS_SUPABASE_PROJECT_REF=YOUR_KOSMOS_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_LOCAL_SUPABASE_ACCESS_TOKEN

# Edge Function secrets. Не коммитить реальные значения.
ANTHROPIC_MODEL=claude-sonnet-4-5
GITHUB_REPO=owner/kosmos-service
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_FOR_EDGE_FUNCTION
KOSMOS_ALLOWED_ORIGINS=http://127.0.0.1:5050,http://localhost:5050
